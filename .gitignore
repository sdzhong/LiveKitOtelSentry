# Environment files -- every .env variant, at any depth, including editor
# backups and copies like .env.bak / .env.local / .env.save. The explicit
# per-directory lines this replaces did not cover those, so a stray backup of
# a real .env was untracked but NOT ignored, and one `git add -A` away from
# being committed with its secrets. The .example templates are re-included
# because they are meant to be in the repo.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
.venv/
env/
*.egg-info/
dist/
build/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# React Native / iOS
mobile/ios/Pods/
mobile/ios/build/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/

# React Native / Android
mobile/android/app/build/
mobile/android/build/
mobile/android/.gradle/
*.jks
*.keystore
!debug.keystore
local.properties

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Misc
*.log
tmp/

