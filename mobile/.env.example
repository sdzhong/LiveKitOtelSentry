# Backend URL
# Point to your running token_server.py instance
# Use your machine's local IP for device testing (not localhost)
# Find your IP: ipconfig getifaddr en0
BACKEND_URL=http://192.168.x.x:8000

# Sentry Configuration
# Get from https://sentry.io - create a React Native project
SENTRY_DSN=https://your-key@your-org.ingest.us.sentry.io/your-project-id
SENTRY_ENV=dev

# Optional: Override room name (defaults to "voice-room")
# LK_ROOM=my-custom-room
