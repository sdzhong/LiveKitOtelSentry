# LiveKit Configuration
# Get these from https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# OpenAI Configuration
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Deepgram Configuration (for STT)
# Get from https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_key

# Sentry Configuration
# Get from https://sentry.io - create a Python project
# Note: OTLPIntegration derives OTLP endpoint from DSN automatically
SENTRY_DSN=https://your-key@your-org.ingest.us.sentry.io/your-project-id
SENTRY_ENV=dev
