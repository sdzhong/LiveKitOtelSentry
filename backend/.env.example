# LiveKit Configuration
# Get these from https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# ---------------------------------------------------------------------------
# LLM + TTS providers
#
# You need EITHER an OpenAI key OR an OpenRouter key (not both).
# Deepgram is always required for STT.
#
#   OpenAI route:      OPENAI_API_KEY   -> LLM + TTS from OpenAI
#   OpenRouter route:  OPENROUTER_API_KEY -> LLM from OpenRouter,
#                                            TTS falls back to Deepgram
#                                            (OpenRouter has no TTS)
#
# Selection is automatic based on which key is present. Override with
# LLM_PROVIDER / TTS_PROVIDER below.
# ---------------------------------------------------------------------------

# Option A: OpenAI. Get from https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-...

# Option B: OpenRouter (OpenAI-API-compatible). Get from https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...

# Deepgram - required for STT, and used for TTS on the OpenRouter route.
# Get from https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_key

# Optional explicit provider overrides
# LLM_PROVIDER=openrouter          # openai | openrouter
# TTS_PROVIDER=deepgram            # openai | deepgram
# LLM_MODEL=openai/gpt-4o-mini     # OpenRouter slug, or a plain OpenAI model name
# TTS_VOICE=alloy                  # OpenAI TTS voice
# DEEPGRAM_TTS_MODEL=aura-2-andromeda-en

# Sentry Configuration
# Get from https://sentry.io - create a Python project
# Note: OTLPIntegration derives the OTLP traces endpoint from the DSN automatically
SENTRY_DSN=https://your-key@your-org.ingest.us.sentry.io/your-project-id
SENTRY_ENV=dev

# Optional: release identifier, shown on Sentry events and used as
# the OTel `service.version` resource attribute on the agent.
# SENTRY_RELEASE=livekit-voice-agent@0.0.1

# Optional: OTel `service.name` for the agent (defaults to "voice-agent").
# This is how the agent shows up as its own service in Sentry.
# OTEL_SERVICE_NAME=voice-agent

# Optional: token server CORS origins, comma-separated (defaults to "*").
# The React Native app does not need CORS; set this if you add a browser client.
# CORS_ALLOW_ORIGINS=http://localhost:3000,https://app.example.com

# Optional: also export OTel *log records* to Sentry's OTLP logs endpoint
# (in addition to the Sentry SDK logs that are on by default). Off by default.
# SENTRY_OTLP_LOGS=1
